REDIS_PASSWORD=change-me
MEDIA_PUBLIC_BASE_URL=http://YOUR_VPS_IP:9100

MONGODB_URL=mongodb+srv://USER:PASS@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=genz_ai_video
INTERNAL_API_TOKEN=shared-token
API_BASE_URL=http://127.0.0.1:8000

CELERY_CONCURRENCY=2
CELERY_LOGLEVEL=INFO
CELERY_SOFT_TIME_LIMIT=900
CELERY_TIME_LIMIT=1200
WORKER_MEM_LIMIT=4g
WORKER_CPUS=2.0

# When false, mock providers raise and projects with mock assets cannot complete.
ALLOW_MOCK=false
PROVIDER_IMAGE=fal
PROVIDER_VIDEO=fal
PROVIDER_TTS=sarvam
PROVIDER_SFX=fal
PROVIDER_MUSIC=fal
PROVIDER_IMAGE_FALLBACKS=
PROVIDER_VIDEO_FALLBACKS=
PROVIDER_TTS_FALLBACKS=
PROVIDER_SFX_FALLBACKS=
PROVIDER_MUSIC_FALLBACKS=
PROVIDER_TIMEOUT_SECONDS=900

DIRECTOR_PROVIDER=groq
GROQ_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Optional — film_studio only
GEMINI_KEY=
GEMINI_MODEL=gemini-3.8-flash
FAL_KEY=
SARVAM_KEY=

FAL_IMAGE_MODEL=fal-ai/flux/schnell
# Max planned length per shot (scene 15s → 3×5s clips).
SHOT_DURATION_SECONDS=5
FAL_VIDEO_CLIP_SECONDS=5
# Starting-scene face lock → later scenes use flux img2img (no uploaded face refs).
FAL_IMAGE_I2I_MODEL=fal-ai/flux/dev/image-to-image
FAL_IMAGE_I2I_STRENGTH=0.65
FAL_LOOK_LOCK_WAIT_SECONDS=600
FAL_VIDEO_MODEL=fal-ai/wan/v2.2-a14b/image-to-video
FAL_SFX_MODEL=fal-ai/mmaudio-v2
FAL_MUSIC_MODEL=CassetteAI/music-generator
FAL_VIDEO_RESOLUTION=480p
FAL_POLL_TIMEOUT_SECONDS=900
# Ordered fal i2v models (docs-verified only). Comma-separated.
FAL_VIDEO_MODEL_CHAIN=fal-ai/wan/v2.2-a14b/image-to-video/turbo,fal-ai/wan/v2.2-a14b/image-to-video
# Requires fal account authorization; unauthorized accounts are always checked.
# Keep false unless fal confirms you may disable. Pipeline still assumes checker on.
FAL_DISABLE_SAFETY_CHECKER=false
# Optional extra comma-separated tokens stripped before fal calls.
FAL_PROMPT_BLOCKED_WORDS=
JOB_MAX_USD=5
MAX_PROJECT_COST_USD=50
# true = fake fal calls, print estimated costs, $0 spend
DRY_RUN=false
